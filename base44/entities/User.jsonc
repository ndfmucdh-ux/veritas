{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "avatar_url": {
      "type": "string",
      "description": "User profile picture URL"
    },
    "hero_url": {
      "type": "string",
      "description": "User hero banner image URL. Defaults to deep-space starfield."
    }
  }
}