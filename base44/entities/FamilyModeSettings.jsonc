{
  "name": "FamilyModeSettings",
  "type": "object",
  "properties": {
    "reading_level": {
      "type": "string",
      "enum": [
        "kids",
        "youth",
        "standard"
      ],
      "default": "standard"
    },
    "content_filter": {
      "type": "string",
      "enum": [
        "simplified",
        "all"
      ],
      "default": "all"
    },
    "parental_controls_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}