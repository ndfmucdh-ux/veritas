{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "default_translation": {
      "type": "string",
      "description": "The user's default Bible (any language). Drives the reader, Verse of the Day, Morning Inspiration and emails."
    },
    "translation_chosen": {
      "type": "boolean",
      "description": "True once the user explicitly picked a default Bible; changing the app language then never overrides it"
    },
    "font_size": {
      "type": "number",
      "default": 18
    },
    "font_size_label": {
      "type": "string",
      "description": "Small, Medium, Large or Extra Large"
    },
    "font_family": {
      "type": "string",
      "enum": [
        "inter",
        "playfair",
        "cinzel"
      ],
      "default": "inter"
    },
    "show_verse_numbers": {
      "type": "boolean",
      "default": true
    },
    "show_red_letter": {
      "type": "boolean",
      "default": true
    },
    "oled_mode": {
      "type": "boolean",
      "description": "Pure black reader background"
    },
    "audio_autoplay": {
      "type": "boolean",
      "default": false
    },
    "daily_audio_goal": {
      "type": "number",
      "description": "Chapters the user wants to listen to each day (empty: no goal, no goal reminder)"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "daily_verse_time": {
      "type": "string",
      "default": "06:00"
    },
    "language": {
      "type": "string",
      "description": "App language: en, es, fr, pt or de"
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "midnight",
        "sepia",
        "light"
      ],
      "default": "dark"
    },
    "theme_mode": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "description": "Appearance mode chosen with the theme toggle"
    },
    "votd_email_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Receive the Verse of the Day email each morning"
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone of the user's device, e.g. America/Detroit. Reminders fire in this local time."
    },
    "reminders": {
      "type": "object",
      "description": "Reminder settings: { channels: {push, email}, streak|scripture|prayer|followup: {enabled, time 'HH:MM'} }",
      "properties": {
        "channels": {
          "type": "object",
          "properties": {
            "push": {
              "type": "boolean"
            },
            "email": {
              "type": "boolean"
            }
          }
        },
        "streak": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "time": {
              "type": "string"
            }
          }
        },
        "scripture": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "time": {
              "type": "string"
            }
          }
        },
        "prayer": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "time": {
              "type": "string"
            }
          }
        },
        "followup": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "time": {
              "type": "string"
            }
          }
        }
      }
    },
    "app_settings": {
      "type": "object",
      "description": "Other per-device settings mirrored to the account (quiet mode, reading goals, audio speed, folders...), keyed by their local storage name"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}