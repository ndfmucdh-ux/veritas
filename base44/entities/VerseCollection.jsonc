{
  "name": "VerseCollection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Collection name e.g. 'Comfort', 'Promises', 'Courage'"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "default": "\ud83d\udcda"
    },
    "color": {
      "type": "string",
      "default": "#00f5ff"
    },
    "verse_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of verse references in the collection"
    },
    "verse_count": {
      "type": "number",
      "default": 0
    },
    "play_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of verse refs for audio playback"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}