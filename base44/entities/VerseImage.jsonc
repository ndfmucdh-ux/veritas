{
  "name": "VerseImage",
  "type": "object",
  "properties": {
    "verse_ref": {
      "type": "string"
    },
    "style_template": {
      "type": "string",
      "enum": [
        "elegant",
        "modern",
        "minimal",
        "artistic"
      ],
      "default": "elegant"
    },
    "image_url": {
      "type": "string"
    },
    "shared_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "verse_ref",
    "image_url"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}