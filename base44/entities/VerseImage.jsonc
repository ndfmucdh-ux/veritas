{
  "name": "VerseImage",
  "type": "object",
  "properties": {
    "verse_ref": {
      "type": "string"
    },
    "style_template": {
      "type": "string",
      "enum": [
        "elegant",
        "modern",
        "minimal",
        "artistic"
      ],
      "default": "elegant"
    },
    "image_url": {
      "type": "string"
    },
    "shared_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "verse_ref",
    "image_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}