{
  "name": "Bookmark",
  "type": "object",
  "properties": {
    "verse_ref": {
      "type": "string"
    },
    "book": {
      "type": "string"
    },
    "chapter": {
      "type": "number"
    },
    "verse": {
      "type": "number"
    },
    "translation": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "Optional custom label"
    }
  },
  "required": [
    "verse_ref"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}