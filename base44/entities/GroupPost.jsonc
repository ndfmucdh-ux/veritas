{
  "name": "GroupPost",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "prayer"
      ],
      "default": "message"
    },
    "text": {
      "type": "string"
    },
    "amen_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids who said Amen or prayed"
    },
    "answered": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "group_id",
    "author_id",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}