{
  "name": "WidgetData",
  "type": "object",
  "properties": {
    "verse_of_day": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "auto"
      ],
      "default": "dark"
    }
  },
  "required": [
    "verse_of_day"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}