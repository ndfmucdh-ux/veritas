{
  "name": "PrayerWallPost",
  "type": "object",
  "properties": {
    "request": {
      "type": "string",
      "description": "The anonymous prayer request text"
    },
    "prayer_count": {
      "type": "number",
      "default": 0,
      "description": "Number of people praying for this request"
    },
    "amen_count": {
      "type": "number",
      "default": 0,
      "description": "Number of Amen responses"
    },
    "prayed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who have prayed (for dedup only, display stays anonymous)",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "healing",
        "family",
        "guidance",
        "gratitude",
        "strength",
        "peace",
        "other"
      ],
      "default": "other"
    },
    "is_answered": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "request"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}