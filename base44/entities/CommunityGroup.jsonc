{
  "name": "CommunityGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "study_group",
        "prayer_circle",
        "accountability",
        "mens_group",
        "womens_group"
      ],
      "default": "study_group"
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "leader_email": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users who joined, so each user is counted once",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "plan_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "book": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "description": "Reading plan content: list of { book, chapters[] }"
    },
    "plan_total_chapters": {
      "type": "number",
      "default": 0
    },
    "plan_days": {
      "type": "number",
      "default": 0,
      "description": "Number of days the plan is meant to take"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}