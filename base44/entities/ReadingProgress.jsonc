{
  "name": "ReadingProgress",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "book": {
      "type": "string"
    },
    "chapter": {
      "type": "number"
    },
    "translation": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reading_time_seconds": {
      "type": "number"
    }
  },
  "required": [
    "book",
    "chapter"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}