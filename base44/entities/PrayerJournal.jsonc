{
  "name": "PrayerJournal",
  "type": "object",
  "properties": {
    "verse_ref": {
      "type": "string",
      "description": "e.g. John 3:16 KJV"
    },
    "prayer_text": {
      "type": "string",
      "description": "User's prayer content"
    },
    "mood": {
      "type": "string",
      "enum": [
        "grateful",
        "confessing",
        "interceding",
        "celebrating"
      ],
      "default": "grateful"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User-defined tags"
    },
    "answered": {
      "type": "boolean",
      "default": false,
      "description": "Whether this prayer has been answered"
    },
    "answered_note": {
      "type": "string",
      "description": "How/when the prayer was answered"
    },
    "answered_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the prayer was marked as answered"
    }
  },
  "required": [
    "prayer_text"
  ]
}