{
  "name": "UserHighlight",
  "type": "object",
  "properties": {
    "verse_ref": {
      "type": "string"
    },
    "book": {
      "type": "string"
    },
    "chapter": {
      "type": "number"
    },
    "verse": {
      "type": "number"
    },
    "translation": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "enum": [
        "yellow",
        "cyan",
        "purple",
        "green",
        "red"
      ],
      "default": "yellow"
    }
  },
  "required": [
    "verse_ref",
    "color"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}