{
  "name": "Reminder Dispatcher (Every 30 Minutes)",
  "description": "Sends each person's streak, scripture, prayer and follow-up reminders at the time they chose, in their own time zone (streak defaults to 8:00 AM local)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reminder_dispatcher",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_dispatcher": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendScheduledReminders",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}